{
  "name": "app",
  "version": "0.12.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.js",
    "start": "next start",
    "lint": "eslint",
    "electron": "node scripts/dev-electron.js",
    "app:build": "next build",
    "app:start": "node scripts/dev-electron.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@types/xlsx": "^0.0.35",
    "exceljs": "^4.4.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "sg.accellearn.invoices",
    "productName": "AccelLearn Invoices",
    "asar": true,
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "AccelLearn-Invoices-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "x64ArchFiles": "**/*.node",
      "category": "public.app-category.business",
      "artifactName": "AccelLearn-Invoices.${ext}"
    }
  }
}
